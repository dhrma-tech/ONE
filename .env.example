# ONE environment variables. Copy to apps/web/.env.local for dev (gitignored) and add the same to Vercel.
# Variables starting with VITE_ are bundled into the client. Everything else is server-only.

# --- Supabase (leave VITE_SUPABASE_URL empty to run in LOCAL MODE: IndexedDB only, no login) ---
VITE_SUPABASE_URL=                 # https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=            # public anon key (safe in client; RLS protects data)
SUPABASE_URL=                      # same as VITE_SUPABASE_URL, read by the server function
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Never prefix with VITE_.
ONE_OWNER_USER_ID=                 # your auth.users id; the API rejects any other user

# --- App ---
APP_ORIGIN=http://localhost:5173   # used for OAuth redirects and CORS
PORTFOLIO_ORIGIN=https://dharma-phi.vercel.app   # only origin allowed to call /api/public-stats
TOKEN_ENCRYPTION_KEY=              # 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=                       # random string; Vercel Cron sends it as a Bearer token

# --- Google Calendar (OAuth web client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# --- GitHub (fine-grained PAT, read-only public data) ---
GITHUB_TOKEN=
GITHUB_USERNAME=dhrma-tech

# --- YouTube Data API v3 key (optional; oEmbed works without it but gives no duration) ---
YOUTUBE_API_KEY=

# --- Buffer (personal API key from Buffer account settings) ---
BUFFER_ACCESS_TOKEN=

# --- Chess.com polite User-Agent contact (email or URL) ---
CHESSCOM_USER_AGENT_CONTACT=
